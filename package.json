  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node local-app.mjs --setup",
    "setup:full": "node local-app.mjs --setup --full",
    "dev": "node local-app.mjs",
