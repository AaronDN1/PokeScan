POKELENS_ENVIRONMENT=development
POKELENS_DATABASE_URL=sqlite+aiosqlite:///./data/pokelens.db
POKELENS_REDIS_URL=
POKELENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
POKELENS_AUTO_CREATE_SCHEMA=true
POKELENS_DEVELOPMENT_DIAGNOSTICS=false

# Optional marketplace enrichment. Direct product links work without keys.
# TCGplayer condition pricing requires pre-existing approved API credentials;
# TCGplayer is not currently granting new API access.
POKELENS_POKEMON_TCG_API_KEY=
POKELENS_TCGPLAYER_PUBLIC_KEY=
POKELENS_TCGPLAYER_PRIVATE_KEY=
POKELENS_TCGPLAYER_API_VERSION=v1.39.0
POKELENS_MARKETPLACE_CACHE_HOURS=12

OCR_BACKEND=paddle
ARTWORK_MATCHER_BACKEND=composite
CUSTOM_ONNX_MODELS_REQUIRED=false
POKELENS_RAPIDOCR_MODEL_TYPE=tiny
POKELENS_PRETRAINED_ARTWORK_MODEL_PATH=models/mobilenetv2-features.onnx

# Optional future custom backends:
POKELENS_NAME_OCR_MODEL_PATH=models/ocr-name.onnx
POKELENS_NUMBER_OCR_MODEL_PATH=models/ocr-number.onnx
POKELENS_ARTWORK_MODEL_PATH=models/artwork-embedding.onnx
